# Dependencies
node_modules/
.pnpm-store/

# Build output
out/
dist/
*.vsix

# Secrets — never commit. See docs/THREAT_MODEL.md T5.2
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.baseer/

# Academic PDFs (copyright; fetched locally, not redistributed). Ignore the
# directory's contents, not the directory itself, so the checksum manifest can
# be re-included — git cannot re-include a file inside an ignored directory.
docs/papers/*
!docs/papers/CHECKSUMS.txt

# Editor / OS
.vscode-test/
.DS_Store
Thumbs.db

# Logs / coverage
*.log
coverage/
.nyc_output/

# Exception: the ADR-0001 spike vsix is a deliverable to be installed for testing.
!spikes/speech-delivery/*.vsix
